<div class="col-md-4">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <span>$<%= @property.price %></span>
                <span>per nigth</span>
            </div>
        </div>
        <div class="card-body">
            <%= form_with model: [@property, Reservation.new], local: true do |form| %>
                <div class="form-group">
                    <%= form.label :check_in %>
                    <%= form.date_field :check_in, min: Date.current, required: true, class: "form-control" %>
                </div>
                <div class="form-group">
                    <%= form.label :check_out %>
                    <%= form.date_field :check_out, min: Date.current + 1.day, required: true, class: "form-control" %>
                </div>
                <%= form.submit "Book", class: "btn btn-primary" %>
            <% end %>
        </div>
    </div>
</div>
